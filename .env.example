# MongoDB Connection String
# Ganti dengan MongoDB Cluster URL Anda
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Secret untuk JWT (wajib diganti dengan string acak saat production)
JWT_SECRET=change-me-ke-string-acak

# Server Port
PORT=5000

# Frontend URL untuk CORS (pisahkan dengan koma jika lebih dari satu)
# Contoh: http://localhost:5173,https://pengeluaran-harian-nu.vercel.app
FRONTEND_URL=http://localhost:5173,https://pengeluaran-harian-nu.vercel.app
